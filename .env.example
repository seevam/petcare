# Database (Neon PostgreSQL)
# These are automatically set by Neon integration in Vercel/hosting
# The prefix "paw" comes from your Neon project name
# paw_POSTGRES_URL: Pooled connection (for app queries)
# paw_POSTGRES_URL_NON_POOLING: Direct connection (for migrations)
paw_POSTGRES_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"
paw_POSTGRES_URL_NON_POOLING="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

# For local development, you can also use standard names:
# DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
CLERK_WEBHOOK_SECRET="whsec_your-webhook-secret"

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your-token"

# Email Service (Resend)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="PawCare <noreply@yourdomain.com>"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza-your-google-maps-api-key"

# Cron Job Secret
CRON_SECRET="your-random-secret-string-for-cron-auth"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
